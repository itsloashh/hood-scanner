// Cloudflare Worker config (hood-scanner-bot) — lets Cloudflare build the Telegram bot straight from this repo
// (Worker → Settings → Builds → Connect to GitHub). No copy-pasting code.
{
  "name": "hood-scanner-bot",
  "main": "worker/worker.js",
  "compatibility_date": "2026-10-01",
  // Secrets (TELEGRAM_BOT_TOKEN, ALLOWED_CHAT_ID, GITHUB_TOKEN, WEBHOOK_SECRET) are added in the
  // Cloudflare dashboard and are never stored here.
  "vars": {
    "GITHUB_REPO": "itsloashh/hood-scanner"
  },
  // The bot's clock: scan + paper TP/SL every 15 min, research daily ~10:23 AM Toronto
  "triggers": {
    "crons": ["*/15 * * * *", "23 14 * * *"]
  },
  // Paper wallet storage (KV namespace "hood-paper")
  "kv_namespaces": [
    { "binding": "PAPER", "id": "f4937e2185f040a8b276010c178b5491" }
  ]
}
